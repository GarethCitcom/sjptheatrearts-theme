        { "key": "field_sjpta_exp_link_label", "label": "Link label", "name": "link_label", "type": "text", "required": 0, "default_value": "Gallery" },
        { "key": "field_sjpta_exp_link_url", "label": "Link", "name": "link_url", "type": "url", "instructions": "Leave empty to link to the Performances page.", "required": 0, "default_value": "" },
        { "key": "field_sjpta_exp_poster", "label": "Feature image", "name": "poster", "type": "image", "return_format": "id", "preview_size": "medium", "library": "all", "required": 0 },
        { "key": "field_sjpta_exp_video_title", "label": "Feature title", "name": "video_title", "type": "text", "required": 0, "default_value": "Watch a rehearsal" },
        { "key": "field_sjpta_exp_video_text", "label": "Feature text", "name": "video_text", "type": "textarea", "rows": 3, "new_lines": "", "required": 0 },
        {
            "key": "field_sjpta_exp_videos",
            "label": "Videos",
            "name": "videos",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add video",
            "max": 4,
            "required": 0,
            "instructions": "Leave empty until the videos exist. While empty the play button is hidden, because a play button with nothing behind it promises something the page cannot deliver. With videos added, the play button opens a pop-up player: the first video plays straight away and each one runs on into the next.",
