                { "key": "field_sjpta_exp_video_file", "label": "Video file", "name": "video", "type": "file", "return_format": "id", "mime_types": "mp4,webm,m4v", "library": "all", "required": 0 },
                { "key": "field_sjpta_exp_video_name", "label": "Title", "name": "title", "type": "text", "instructions": "Shown in the player and on the video's thumbnail.", "required": 0 },
