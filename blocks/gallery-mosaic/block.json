{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "sjptheatrearts/gallery-mosaic",
	"title": "SJP gallery mosaic",
	"category": "theme",
	"icon": "format-gallery",
	"description": "A four-column photo mosaic where chosen tiles span two columns or two rows.",
	"textdomain": "sjptheatrearts",
	"supports": {
		"align": false,
		"anchor": true,
		"html": false,
		"customClassName": false,
		"jsx": false
	},
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"style": [
		"file:./style.css",
		"sjpta-primitives",
		"sjpta-lightbox"
	],
	"viewScript": [
		"sjpta-lightbox",
		"sjpta-gallery-filter"
	]
}
