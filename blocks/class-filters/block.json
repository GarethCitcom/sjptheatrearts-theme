{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "sjptheatrearts/class-filters",
	"title": "SJP class filters",
	"category": "theme",
	"icon": "filter",
	"description": "The filter bar for the class list. Works without JavaScript; filters in place with it.",
	"textdomain": "sjptheatrearts",
	"supports": {
		"align": false,
		"anchor": true,
		"html": false,
		"customClassName": false,
		"jsx": false
	},
	"style": [
		"file:./style.css",
		"sjpta-primitives"
	],
	"viewScript": [
		"sjpta-class-filters"
	],
	"render": "file:./render.php"
}
