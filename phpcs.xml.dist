<?xml version="1.0"?>
<ruleset name="SJP Theatre Arts theme">
	<description>WordPress coding standards for the SJP Theatre Arts block theme.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/design-reference/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- Brief: PHP 8.1+. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Brief: WordPress 6.8+, built compatible with 7.x. -->
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress">
		<!-- Block theme render templates are not classic template files. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sjptheatrearts"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<!-- WPCS requires 4+ characters; "sjp" is rejected as too short. -->
			<property name="prefixes" type="array">
				<element value="sjpta"/>
				<element value="SJPTA"/>
			</property>
		</properties>
	</rule>
</ruleset>
