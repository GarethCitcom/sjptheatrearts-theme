{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1320px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "brand-orange",
					"color": "#FE7300",
					"name": "Brand orange"
				},
				{
					"slug": "brand-purple",
					"color": "#381064",
					"name": "Brand purple"
				},
				{
					"slug": "deep-purple",
					"color": "#2A0B4D",
					"name": "Deep purple"
				},
				{
					"slug": "darkest-purple",
					"color": "#1D0B36",
					"name": "Darkest purple"
				},
				{
					"slug": "magenta",
					"color": "#C5299B",
					"name": "Magenta"
				},
				{
					"slug": "page-background",
					"color": "#F7F6F9",
					"name": "Page background"
				},
				{
					"slug": "surface",
					"color": "#FFFFFF",
					"name": "Surface"
				},
				{
					"slug": "text-body",
					"color": "#211B27",
					"name": "Body text"
				},
				{
					"slug": "text-secondary",
					"color": "#5A5265",
					"name": "Secondary text"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "poppins",
					"name": "Poppins",
					"fontFamily": "Poppins, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-600.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-700.woff2"
							]
						}
					]
				},
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/montserrat-variable.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "eyebrow",
					"name": "Eyebrow",
					"size": "0.75rem",
					"fluid": {
						"min": "0.6875rem",
						"max": "0.75rem"
					}
				},
				{
					"slug": "meta",
					"name": "Meta / label",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "fine-print",
					"name": "Small print",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "card-body",
					"name": "Card body",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1rem",
					"fluid": {
						"min": "0.9375rem",
						"max": "1rem"
					}
				},
				{
					"slug": "intro",
					"name": "Page intro",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "hero-body",
					"name": "Hero body",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "card-title",
					"name": "Card heading (17-20px)",
					"size": "1.25rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "card-lg",
					"size": "1.5rem",
					"name": "Card large",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "section-sm",
					"name": "Section heading, small (25-36px)",
					"size": "2.25rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "section-md",
					"size": "2.5rem",
					"name": "Section medium",
					"fluid": {
						"min": "1.3125rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "section-lg",
					"name": "Section heading, large (38-46px)",
					"size": "2.875rem",
					"fluid": {
						"min": "1.375rem",
						"max": "2.875rem"
					}
				},
				{
					"slug": "page-title",
					"name": "Page heading (52-58px)",
					"size": "3.375rem",
					"fluid": {
						"min": "1.75rem",
						"max": "3.375rem"
					}
				},
				{
					"slug": "display",
					"name": "Homepage heading (76px)",
					"size": "4.75rem",
					"fluid": {
						"min": "1.875rem",
						"max": "4.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "3XS (8px)",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2XS (12px)",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "XS (16px)",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "SM (22px)",
					"size": "1.375rem"
				},
				{
					"slug": "50",
					"name": "MD (24px)",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "LG (32px)",
					"size": "2rem"
				},
				{
					"slug": "70",
					"name": "Section, tight (56px)",
					"size": "clamp(2.5rem, 1.786rem + 3.05vw, 3.5rem)"
				},
				{
					"slug": "80",
					"name": "Section (80px)",
					"size": "clamp(3.25rem, 2.179rem + 4.57vw, 5rem)"
				},
				{
					"slug": "90",
					"name": "Section, roomy (110px)",
					"size": "clamp(4rem, 2.036rem + 8.38vw, 6.875rem)"
				},
				{
					"slug": "100",
					"name": "Hero (150px)",
					"size": "clamp(4.5rem, 1.393rem + 13.26vw, 9.375rem)"
				}
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "nav",
					"name": "Floating nav",
					"shadow": "0 14px 34px -18px rgba(33, 11, 60, 0.35)"
				},
				{
					"slug": "frame",
					"name": "Device frame",
					"shadow": "0 18px 44px -22px rgba(29, 11, 54, 0.4)"
				},
				{
					"slug": "header-rest",
					"name": "Header at rest",
					"shadow": "0 4px 24px -12px rgba(33, 27, 39, 0.18)"
				},
				{
					"slug": "header-stuck",
					"name": "Header stuck",
					"shadow": "0 10px 30px -14px rgba(33, 27, 39, 0.32)"
				}
			]
		},
		"custom": {
			"radius": {
				"image": "10px",
				"small": "12px",
				"card": "16px",
				"band": "28px",
				"pill": "999px"
			},
			"control": {
				"min": "44px",
				"sidebar": "46px",
				"hero": "52px"
			},
			"border": {
				"card": "1px solid #EAE3F0",
				"inner": "1px solid #F0EBF5"
			},
			"motion": {
				"easing": "cubic-bezier(0.22, 0.61, 0.36, 1)",
				"reveal": "0.72s",
				"lift": "0.32s",
				"ticker": "36s"
			},
			"focus": {
				"color": "#6A3AA0",
				"width": "3px",
				"offset": "3px"
			},
			"color": {
				"orange-hover": "#e56800",
				"orange-light": "#FF9A3D",
				"orange-text": "#B85400",
				"card-border": "#EAE3F0",
				"inner-divider": "#F0EBF5",
				"section-rule": "#E9E4F0",
				"nav-divider": "#EEE7F4",
				"text-muted": "#736C7E",
				"text-on-purple": "#D9C8EC",
				"text-on-purple-dim": "#B49BD3",
				"success-green": "#26CC8C",
				"badge-purple-bg": "#EFE7F7",
				"badge-purple-fg": "#6A3AA0",
				"badge-orange-bg": "#FFE9D6",
				"badge-orange-fg": "#A34A00",
				"badge-magenta-bg": "#FAE6F4",
				"badge-magenta-fg": "#9C1F7A",
				"badge-green-bg": "#DFF7EC",
				"badge-green-fg": "#0F7350",
				"bt-red": "#F63631",
				"bt-red-hover": "#d92b26",
				"bt-violet": "#791B93",
				"bt-lilac": "#D193FF",
				"bt-red-light": "#F9AFAD",
				"tint-red": "#FFF1F0",
				"tint-red-fg": "#8A4A46",
				"tint-lilac": "#F5EBFF",
				"tint-lilac-fg": "#6A3AA0",
				"tint-peach": "#FFF5E9",
				"tint-peach-fg": "#96603A",
				"tint-mint": "#EDF8F3",
				"tint-mint-fg": "#2C6B54",
				"bt-pill-red-fg": "#B32C28",
				"bt-step-surface": "#FBF9FC",
				"bt-mosaic-bg": "#4A1B7A",
				"bt-on-dark": "#EDE4F5",
				"bt-input-border": "#E3DBEB",
				"bt-card-border": "#F9CFCD"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		},
		"lightbox": {
			"enabled": false,
			"allowEditing": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page-background)",
			"text": "var(--wp--preset--color--text-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--60)",
				"right": "var(--wp--preset--spacing--60)"
			},
			"blockGap": "var(--wp--preset--spacing--50)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--brand-purple)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--page-title)",
					"lineHeight": "1.06",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section-lg)",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--card-title)",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"letterSpacing": "0"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--intro)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"letterSpacing": "0"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)",
					"fontWeight": "600",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--meta)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				},
				"color": {
					"text": "var(--wp--custom--color--text-muted)"
				}
			},
			"link": {
				"color": {
					"text": "var(--sjpta-accent-text)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--sjpta-accent-2)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--focus--color)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--sjpta-accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "var(--wp--preset--font-size--card-body)",
					"fontWeight": "700",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "0.9375rem",
						"bottom": "0.9375rem",
						"left": "1.375rem",
						"right": "1.375rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--sjpta-accent-hover)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--focus--color)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)",
						"offset": "var(--wp--custom--focus--offset)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--fine-print)"
				},
				"color": {
					"text": "var(--wp--custom--color--text-muted)"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--custom--color--section-rule)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "header-born-to-be",
			"title": "Header (Born To Be)",
			"area": "header"
		},
		{
			"name": "cta-band",
			"title": "Closing CTA band",
			"area": "uncategorized"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "single-sjp-class",
			"title": "Class",
			"postTypes": [
				"sjp-class"
			]
		}
	]
}
